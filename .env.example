# CodeLens AI - Environment Configuration Example
# Copy this file to .env and configure as needed.

# Django Security Key
SECRET_KEY=django-insecure-codelens-ai-hackathon-production-secret-key-change-in-prod

# Debug Mode (set False for production)
DEBUG=True

# Allowed Hosts (comma-separated or * for local)
ALLOWED_HOSTS=127.0.0.1,localhost

# Google Gemini API Key (Optional for cloud LLM & embeddings; offline local mode runs automatically without it)
GEMINI_API_KEY=

# Preferred Embedder: 'auto', 'local', or 'gemini'
EMBEDDER_PREFERENCE=auto
